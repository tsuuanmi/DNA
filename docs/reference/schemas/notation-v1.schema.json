{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal:schema:notation:v1",
  "title": "DNA notation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "provenance",
    "notation"
  ],
  "properties": {
    "schema_version": {
      "const": "dna.notation/v1"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "notation": {
      "$ref": "#/$defs/notation"
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "topology",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "enum": [
            "linear",
            "circular"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "family": {
            "enum": [
              "modality",
              "core",
              "post_calling"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "notation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "calls"
      ],
      "properties": {
        "style": {
          "const": "per_base_decimal"
        },
        "calls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/notationCall"
          }
        }
      }
    },
    "notationCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "reads"
      ],
      "properties": {
        "call": {
          "type": "string",
          "pattern": "^(?:(?:0|[1-9][0-9]*)\\.[1-9][0-9]*[ACGT]|[1-9][0-9]*(?:[ACGT]|DEL))$"
        },
        "reads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "configuration_sha256",
        "profile",
        "plugins",
        "source"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "plugins": {
          "$ref": "#/$defs/plugins"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "dna.variants/v1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "rule": {
      "enum": [
        "insertion_at_run_end",
        "insertion_matches_run"
      ]
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "findings"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "read",
              "calls"
            ],
            "properties": {
              "rule": {
                "$ref": "#/$defs/rule"
              },
              "read": {
                "type": "string",
                "minLength": 1
              },
              "calls": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          }
        }
      }
    }
  }
}
