{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal:schema:notation:v1",
  "title": "DNA notation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "provenance",
    "notation"
  ],
  "properties": {
    "schema_version": {
      "const": "dna.notation/v1"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "notation": {
      "$ref": "#/$defs/notation"
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    },
    "empop": {
      "$ref": "#/$defs/empop"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "topology",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "enum": [
            "linear",
            "circular"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "family": {
            "enum": [
              "modality",
              "core",
              "post_calling"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "notation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style",
        "calls"
      ],
      "properties": {
        "style": {
          "const": "per_base_decimal"
        },
        "calls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/notationCall"
          }
        }
      }
    },
    "notationCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "reads"
      ],
      "properties": {
        "call": {
          "type": "string",
          "pattern": "^(?:(?:0|[1-9][0-9]*)\\.[1-9][0-9]*[ACGT]|[1-9][0-9]*(?:[ACGT]|DEL))$"
        },
        "convention": {
          "description": "The profile report convention labelling the call (SRS-NOM-017); absent when none does. A labelled call is kept.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "label"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "enum": [
                "not_recorded"
              ]
            }
          }
        },
        "reads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "configuration_sha256",
        "profile",
        "plugins",
        "source"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "plugins": {
          "$ref": "#/$defs/plugins"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "dna.variants/v1"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "rule": {
      "enum": [
        "insertion_at_run_end",
        "insertion_matches_run"
      ]
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "findings"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "read",
              "calls"
            ],
            "properties": {
              "rule": {
                "$ref": "#/$defs/rule"
              },
              "read": {
                "type": "string",
                "minLength": 1
              },
              "calls": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          }
        }
      }
    },
    "empop": {
      "description": "The offline EMPOP query (PROP-0007), present when the profile declares [empop]. A range covers only positions exactly one record calls; EMPOP reads an omission inside a range as the reference.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranges",
        "ranges_text",
        "mitotype",
        "cut"
      ],
      "properties": {
        "ranges": {
          "description": "1-based inclusive interpretation ranges, in the profile's region order and within a region in position order.",
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "ranges_text": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*-[1-9][0-9]*(?: [1-9][0-9]*-[1-9][0-9]*)*)?$"
        },
        "mitotype": {
          "description": "The rCRS-coded calls inside the ranges, distinct, by position and then insertion ordinal, space-separated.",
          "type": "string",
          "pattern": "^(?:(?:(?:0|[1-9][0-9]*)\\.[1-9][0-9]*[ACGTRYSWKMBDHVN]|[1-9][0-9]*(?:[ACGTRYSWKMBDHVN]|DEL))(?: (?:(?:0|[1-9][0-9]*)\\.[1-9][0-9]*[ACGTRYSWKMBDHVN]|[1-9][0-9]*(?:[ACGTRYSWKMBDHVN]|DEL)))*)?$"
        },
        "cut": {
          "description": "Positions inside a profile region and a record that no range covers, 1-based inclusive, and why.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "reason"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "enum": [
                  "unresolved",
                  "excluded_variant",
                  "overlap"
                ]
              }
            }
          }
        }
      }
    }
  }
}
