{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal:schema:review:v1",
  "title": "DNA review v1",
  "description": "One sample's review list (PROP-0004). Shapes shared with dna.notation/v1 and dna.consensus/v1 are referenced from those schemas by $id, so a validator needs all three registered.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "status",
    "provenance",
    "reads",
    "items",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "dna.review/v1"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "status": {
      "enum": [
        "called",
        "rejected",
        "call_failed"
      ]
    },
    "error": {
      "description": "Why the call failed; present exactly for call_failed.",
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "reads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/read"
      }
    },
    "calls": {
      "description": "The sample's calls in the profile notation; for called under a profile that declares notation.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/call"
      }
    },
    "callable": {
      "description": "The call's callable reference segments, merged, 1-based inclusive; for called.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/range"
      }
    },
    "reference_only": {
      "description": "Reportable positions (1-based, increasing) the consensus decided as the reference by reference confirmations alone (ADR-0080); for called.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "empop": {
      "$ref": "urn:signal:schema:notation:v1#/$defs/empop"
    },
    "zones": {
      "description": "The reportable positions as zones a reviewer opens whole, in reference order: each a maximal stretch, within one region, of one kind (and, for repeat, one profile window); for called.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "called"
          }
        }
      },
      "then": {
        "required": [
          "callable",
          "zones",
          "reference_only"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "call_failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "calls": false,
          "callable": false,
          "reference_only": false,
          "empop": false,
          "zones": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "error": false,
          "calls": false,
          "callable": false,
          "reference_only": false,
          "empop": false,
          "zones": false,
          "items": {
            "maxItems": 0
          },
          "reads": {
            "items": {
              "properties": {
                "admitted": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strand": {
      "enum": [
        "forward",
        "reverse"
      ]
    },
    "base": {
      "enum": [
        "A",
        "C",
        "G",
        "T"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "configuration_sha256",
        "profile",
        "plugins",
        "rules"
      ],
      "properties": {
        "reference": {
          "$ref": "urn:signal:schema:notation:v1#/$defs/reference"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "urn:signal:schema:notation:v1#/$defs/profile"
        },
        "plugins": {
          "$ref": "urn:signal:schema:notation:v1#/$defs/plugins"
        },
        "rules": {
          "description": "Version of the labelling rules, equal to the review plugin version.",
          "type": "integer",
          "minimum": 1
        },
        "signal": {
          "description": "The run signal (dna.signal/v1) the second-channel thresholds were judged against, when one was given.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "sha256",
            "selection"
          ],
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "selection": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "read": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "strand",
            "admitted",
            "masked",
            "mixtures"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "strand": {
              "$ref": "#/$defs/strand"
            },
            "admitted": {
              "const": true
            },
            "masked": {
              "description": "The read's masked stretches over the reportable regions, from the modality's callability segments (SRS-API-014): reference positions its aligned calls cover while its signal is dephased, mixed, weak, or irregularly spaced, so that it does not show its bases there.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "first",
                  "last",
                  "state",
                  "after_repeat"
                ],
                "properties": {
                  "first": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "last": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "state": {
                    "enum": [
                      "dephased",
                      "mixed",
                      "weak",
                      "irregular"
                    ]
                  },
                  "after_repeat": {
                    "type": "boolean"
                  }
                }
              }
            },
            "mixtures": {
              "description": "The read's phase mixtures (ADR-0082): stretches after a run whose signal the modality asserts is the read's own sequence superposed with copies offset by whole calls, each component compared with the reference on its own. Display only.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/mixture"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "admitted",
            "rejection"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "admitted": {
              "const": false
            },
            "rejection": {
              "$ref": "urn:signal:schema:consensus:v1#/$defs/readRejection"
            }
          }
        }
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call",
        "position",
        "ordinal",
        "reference",
        "alternate"
      ],
      "properties": {
        "call": {
          "$ref": "urn:signal:schema:notation:v1#/$defs/notationCall/properties/call"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "reference": {
          "description": "The reference base; null for an inserted base.",
          "oneOf": [
            {
              "$ref": "#/$defs/base"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternate": {
          "description": "The called base; null for a deleted base.",
          "oneOf": [
            {
              "$ref": "#/$defs/base"
            },
            {
              "type": "null"
            }
          ]
        },
        "convention": {
          "$ref": "urn:signal:schema:notation:v1#/$defs/notationCall/properties/convention"
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "ordinal"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "last",
        "kind",
        "decision",
        "sequence",
        "calls",
        "labels",
        "evidence"
      ],
      "properties": {
        "first": {
          "$ref": "#/$defs/column"
        },
        "last": {
          "$ref": "#/$defs/column"
        },
        "kind": {
          "enum": [
            "variant",
            "check"
          ]
        },
        "decision": {
          "enum": [
            "called",
            "partly_callable",
            "not_callable"
          ]
        },
        "sequence": {
          "description": "The decided sequence over the item: a site's call (N where undecided, empty when every position is deleted) or the reference base of a position outside every site; null when nothing was decided.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[ACGTN]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "calls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:signal:schema:notation:v1#/$defs/notationCall/properties/call"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "label": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "reads"
          ],
          "properties": {
            "label": {
              "const": "strands_disagree"
            },
            "reads": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "read",
                  "strand",
                  "role"
                ],
                "properties": {
                  "read": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strand": {
                    "$ref": "#/$defs/strand"
                  },
                  "role": {
                    "enum": [
                      "supporting",
                      "opposing"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read",
            "strand",
            "sequence"
          ],
          "properties": {
            "label": {
              "const": "read_disagrees"
            },
            "read": {
              "type": "string",
              "minLength": 1
            },
            "strand": {
              "$ref": "#/$defs/strand"
            },
            "sequence": {
              "type": "string",
              "pattern": "^[ACGT]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "position",
            "base",
            "reads"
          ],
          "properties": {
            "label": {
              "const": "possible_heteroplasmy"
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "base": {
              "$ref": "#/$defs/base"
            },
            "reads": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "read",
                  "strand",
                  "share",
                  "threshold"
                ],
                "properties": {
                  "read": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strand": {
                    "$ref": "#/$defs/strand"
                  },
                  "share": {
                    "description": "The read's second peak share (SRS-CALL-015), above its threshold.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.5
                  },
                  "threshold": {
                    "description": "The share the second base had to exceed (SRS-CALL-020).",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "calls": {
                    "description": "The key's calls in the run signal, the sample's own taken out, when its run level was usable.",
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "runs"
          ],
          "properties": {
            "label": {
              "const": "estimated_length"
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "urn:signal:schema:consensus:v1#/$defs/run"
                  },
                  {
                    "properties": {
                      "length_evidence": {
                        "enum": [
                          "phase_loss",
                          "reference_frame"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "const": "undecided"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "const": "not_called"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "runs"
          ],
          "properties": {
            "label": {
              "const": "long_run"
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "base",
                  "length",
                  "reference_length",
                  "length_evidence"
                ],
                "properties": {
                  "base": {
                    "enum": [
                      "A",
                      "C",
                      "G",
                      "T"
                    ]
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reference_length": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "length_evidence": {
                    "enum": [
                      "in_phase",
                      "anchored_end",
                      "confirmed_end",
                      "phase_loss",
                      "reference_frame",
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read"
          ],
          "properties": {
            "label": {
              "const": "edge_deletion"
            },
            "read": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read"
          ],
          "properties": {
            "label": {
              "const": "run_deletion"
            },
            "read": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read"
          ],
          "properties": {
            "label": {
              "const": "one_read"
            },
            "read": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "strand",
            "reads"
          ],
          "properties": {
            "label": {
              "const": "one_strand"
            },
            "strand": {
              "$ref": "#/$defs/strand"
            },
            "reads": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read",
            "reason"
          ],
          "properties": {
            "label": {
              "const": "noisy_signal"
            },
            "read": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "const": "not_covered"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read",
            "from"
          ],
          "properties": {
            "label": {
              "const": "phase_shift"
            },
            "read": {
              "type": "string",
              "minLength": 1
            },
            "from": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "runs"
          ],
          "properties": {
            "label": {
              "const": "dephased_end"
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "urn:signal:schema:consensus:v1#/$defs/run"
                  },
                  {
                    "properties": {
                      "length_evidence": {
                        "const": "anchored_end"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "read"
          ],
          "properties": {
            "label": {
              "const": "read_edge"
            },
            "read": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "sha256",
        "strand",
        "positions"
      ],
      "properties": {
        "read": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "strand": {
          "$ref": "#/$defs/strand"
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "ordinal",
        "base",
        "state",
        "call",
        "scope",
        "scan",
        "quality",
        "second"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "const": 0
        },
        "base": {
          "enum": [
            "A",
            "C",
            "G",
            "T",
            "N",
            "-"
          ]
        },
        "state": {
          "enum": [
            "reference",
            "alternate",
            "unresolved",
            "deletion",
            "masked"
          ]
        },
        "call": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "oneOf": [
            {
              "enum": [
                "full",
                "base"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scan": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "second": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base",
                "share"
              ],
              "properties": {
                "base": {
                  "$ref": "#/$defs/base"
                },
                "share": {
                  "description": "The call's second peak share (SRS-CALL-015).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.5
                },
                "cause": {
                  "description": "Why the call shows a second peak, from its signal (SRS-CALL-021): the modality's cause, refined by the run signal to `context` when one is given; absent when the share does not reach signal_processing.second_floor.",
                  "enum": [
                    "noise",
                    "neighbour_tail",
                    "off_centre",
                    "dye_blob",
                    "phase_shift",
                    "context",
                    "second_template",
                    "mixed_stretch"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "checks",
        "variants",
        "labels",
        "positions",
        "zones",
        "clear"
      ],
      "properties": {
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strands_disagree",
            "read_disagrees",
            "possible_heteroplasmy",
            "estimated_length",
            "undecided",
            "not_called",
            "long_run",
            "edge_deletion",
            "run_deletion",
            "one_read",
            "one_strand",
            "noisy_signal",
            "not_covered",
            "phase_shift",
            "dephased_end",
            "read_edge"
          ],
          "properties": {
            "strands_disagree": {
              "type": "integer",
              "minimum": 0
            },
            "read_disagrees": {
              "type": "integer",
              "minimum": 0
            },
            "possible_heteroplasmy": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_length": {
              "type": "integer",
              "minimum": 0
            },
            "undecided": {
              "type": "integer",
              "minimum": 0
            },
            "not_called": {
              "type": "integer",
              "minimum": 0
            },
            "long_run": {
              "type": "integer",
              "minimum": 0
            },
            "edge_deletion": {
              "type": "integer",
              "minimum": 0
            },
            "run_deletion": {
              "type": "integer",
              "minimum": 0
            },
            "one_read": {
              "type": "integer",
              "minimum": 0
            },
            "one_strand": {
              "type": "integer",
              "minimum": 0
            },
            "noisy_signal": {
              "type": "integer",
              "minimum": 0
            },
            "not_covered": {
              "type": "integer",
              "minimum": 0
            },
            "phase_shift": {
              "type": "integer",
              "minimum": 0
            },
            "dephased_end": {
              "type": "integer",
              "minimum": 0
            },
            "read_edge": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "positions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reportable",
            "check",
            "reference_only"
          ],
          "properties": {
            "reportable": {
              "type": "integer",
              "minimum": 0
            },
            "check": {
              "type": "integer",
              "minimum": 0
            },
            "reference_only": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "zones": {
          "description": "The zones, and those a check item touches.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "check"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "check": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "clear": {
          "type": "boolean"
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "first",
        "last",
        "checks"
      ],
      "properties": {
        "kind": {
          "description": "What the reads show there, in precedence order: a profile repeat window, no callable call, a read past a repeat out of phase, a read otherwise masked, every read in phase or vouched for.",
          "enum": [
            "repeat",
            "not_callable",
            "dephased",
            "masked",
            "clean"
          ]
        },
        "first": {
          "type": "integer",
          "minimum": 1
        },
        "last": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "description": "The profile's repeat window name; exactly for repeat.",
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "description": "The check items touching the zone.",
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "repeat"
          }
        }
      },
      "then": {
        "required": [
          "name"
        ]
      },
      "else": {
        "not": {
          "required": [
            "name"
          ]
        }
      }
    },
    "mixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explained",
        "components",
        "unexplained"
      ],
      "properties": {
        "explained": {
          "description": "Whether the components explain the stretch at the read's own noise level (ADR-0082). Only then is each component compared with the reference; otherwise components carry offset and fraction alone.",
          "type": "boolean"
        },
        "components": {
          "description": "Every component the modality asserts, the dominant sequence (offset 0) first; in an explained mixture a component placed on the reference also gives its interval, sequence, and calls.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "unexplained": {
          "description": "Reference positions (1-based, increasing) of the calls the components do not explain.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "explained": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "components": {
                "items": {
                  "properties": {
                    "first": false,
                    "last": false,
                    "sequence": false,
                    "calls": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "fraction"
      ],
      "properties": {
        "offset": {
          "description": "Calls by which the sequence's run is longer (positive) or shorter (negative) than the dominant one's.",
          "type": "integer"
        },
        "fraction": {
          "description": "Its share of the fitted signal.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "first": {
          "description": "First reference position the component covers; after last when it crosses the origin.",
          "type": "integer",
          "minimum": 1
        },
        "last": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "description": "Its bases over first..last on the reference strand.",
          "type": "string",
          "pattern": "^[ACGTN]*$"
        },
        "calls": {
          "description": "Its eligible edits in the profile notation, in reference order; empty under a profile without notation.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "dependentRequired": {
        "first": [
          "last",
          "sequence",
          "calls"
        ],
        "last": [
          "first",
          "sequence",
          "calls"
        ],
        "sequence": [
          "first",
          "last",
          "calls"
        ],
        "calls": [
          "first",
          "last",
          "sequence"
        ]
      }
    }
  }
}
