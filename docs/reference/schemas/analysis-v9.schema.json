{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal:schema:analysis:v9",
  "title": "DNA compact analysis v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance",
    "read",
    "signal_quality",
    "alignment",
    "variants",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "dna.analysis/v9"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "read": {
      "$ref": "#/$defs/read"
    },
    "signal_quality": {
      "$ref": "#/$defs/signalQuality"
    },
    "alignment": {
      "$ref": "#/$defs/alignment"
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "warnings": {
      "$ref": "#/$defs/warnings"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "reference",
        "configuration_sha256",
        "profile",
        "plugins"
      ],
      "properties": {
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "topology",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "topology": {
              "enum": [
                "linear",
                "circular"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "plugins": {
          "$ref": "#/$defs/plugins"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_count",
        "trim",
        "callability"
      ],
      "properties": {
        "call_count": {
          "type": "integer",
          "minimum": 1
        },
        "trim": {
          "$ref": "#/$defs/interval"
        },
        "callability": {
          "$ref": "#/$defs/callability"
        }
      }
    },
    "callability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callable_span",
        "segments",
        "masked_calls"
      ],
      "properties": {
        "callable_span": {
          "$ref": "#/$defs/interval"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/callabilitySegment"
          }
        },
        "masked_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "callabilitySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "state",
        "after_repeat"
      ],
      "properties": {
        "calls": {
          "$ref": "#/$defs/interval"
        },
        "state": {
          "$ref": "#/$defs/phaseState"
        },
        "after_repeat": {
          "type": "boolean"
        },
        "shadow_offsets": {
          "description": "Reported shadow offsets of a dephased segment in ascending order; offset k means the shadow at a call copies the primary call k positions away. Present exactly when state is dephased and then includes a one-call offset.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "enum": [
              -3,
              -2,
              -1,
              1,
              2,
              3
            ]
          },
          "contains": {
            "enum": [
              -1,
              1
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "dephased"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "shadow_offsets"
            ]
          },
          "else": {
            "not": {
              "required": [
                "shadow_offsets"
              ]
            }
          }
        }
      ]
    },
    "phaseState": {
      "enum": [
        "in_phase",
        "dephased",
        "mixed",
        "weak",
        "irregular"
      ]
    },
    "noisyRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "samples",
        "minimum_primary_snr"
      ],
      "properties": {
        "calls": {
          "$ref": "#/$defs/interval"
        },
        "samples": {
          "$ref": "#/$defs/interval"
        },
        "minimum_primary_snr": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "signalQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrity",
        "noisy_regions"
      ],
      "properties": {
        "noisy_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noisyRegion"
          }
        },
        "integrity": {
          "$ref": "#/$defs/integrity"
        }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "callable_bases",
        "identity",
        "unresolved_bases",
        "masked_bases",
        "gap_opens",
        "reference_segments",
        "callable_reference_segments",
        "wraps_origin"
      ],
      "properties": {
        "orientation": {
          "enum": [
            "forward",
            "reverse"
          ]
        },
        "callable_bases": {
          "type": "integer",
          "minimum": 1
        },
        "identity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unresolved_bases": {
          "type": "integer",
          "minimum": 0
        },
        "masked_bases": {
          "description": "Aligned query bases from masked calls, presented to alignment as unresolved; not counted in unresolved_bases or callable_bases.",
          "type": "integer",
          "minimum": 0
        },
        "gap_opens": {
          "type": "integer",
          "minimum": 0
        },
        "reference_segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "callable_reference_segments": {
          "description": "Reference intervals observed by unmasked calls and by deletions between them, in alignment order; each lies inside one reference segment. A covered position outside them is covered by a masked call.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        },
        "wraps_origin": {
          "type": "boolean"
        }
      }
    },
    "variantCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "reference",
        "alternate",
        "kind",
        "calls"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "reference": {
          "type": "string",
          "pattern": "^[ACGT]+$"
        },
        "alternate": {
          "type": "string",
          "pattern": "^[ACGT]+$"
        },
        "kind": {
          "enum": [
            "SNV",
            "INS",
            "DEL"
          ]
        },
        "calls": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "snvVariant": {
      "allOf": [
        {
          "$ref": "#/$defs/variantCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SNV"
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/variantCall"
                  },
                  {
                    "properties": {
                      "role": {
                        "const": "supporting"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "insertionVariant": {
      "allOf": [
        {
          "$ref": "#/$defs/variantCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "INS"
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/variantCall"
              },
              "contains": {
                "allOf": [
                  {
                    "$ref": "#/$defs/variantCall"
                  },
                  {
                    "properties": {
                      "role": {
                        "const": "supporting"
                      }
                    }
                  }
                ]
              },
              "minContains": 1
            }
          }
        }
      ]
    },
    "deletionVariant": {
      "allOf": [
        {
          "$ref": "#/$defs/variantCore"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "DEL"
            },
            "calls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/variantCall"
                  },
                  {
                    "properties": {
                      "role": {
                        "const": "flanking"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "variant": {
      "oneOf": [
        {
          "$ref": "#/$defs/snvVariant"
        },
        {
          "$ref": "#/$defs/insertionVariant"
        },
        {
          "$ref": "#/$defs/deletionVariant"
        }
      ]
    },
    "warnings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_primary_calls",
        "multi_channel_unresolved_calls",
        "ploc_vendor_length_mismatches",
        "clipped_channel_samples",
        "excluded_variant_candidates"
      ],
      "properties": {
        "unresolved_primary_calls": {
          "type": "integer",
          "minimum": 0
        },
        "multi_channel_unresolved_calls": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_variant_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "ploc_vendor_length_mismatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "clipped_channel_samples": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "peakHeights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "C",
        "G",
        "T"
      ],
      "properties": {
        "A": {
          "type": "integer"
        },
        "C": {
          "type": "integer"
        },
        "G": {
          "type": "integer"
        },
        "T": {
          "type": "integer"
        }
      }
    },
    "variantCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "base",
        "peaks",
        "quality"
      ],
      "properties": {
        "role": {
          "enum": [
            "supporting",
            "flanking"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^[ACGT]$"
        },
        "peaks": {
          "$ref": "#/$defs/peakHeights"
        },
        "quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ploc_count",
        "duplicate_ploc_positions",
        "clipped_channel_samples"
      ],
      "properties": {
        "ploc_count": {
          "type": "integer",
          "minimum": 1
        },
        "duplicate_ploc_positions": {
          "type": "integer",
          "minimum": 0
        },
        "vendor_primary_count": {
          "type": "integer",
          "minimum": 0
        },
        "vendor_quality_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_ploc_spacing": {
          "type": "integer",
          "minimum": 1
        },
        "median_ploc_spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_ploc_spacing": {
          "type": "integer",
          "minimum": 1
        },
        "clipped_channel_samples": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_to_median_event_signal_ratio": {
          "type": "number",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ploc_count": {
                "minimum": 2
              }
            },
            "required": [
              "ploc_count"
            ]
          },
          "then": {
            "required": [
              "minimum_ploc_spacing",
              "median_ploc_spacing",
              "maximum_ploc_spacing"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum_ploc_spacing"
                  ]
                },
                {
                  "required": [
                    "median_ploc_spacing"
                  ]
                },
                {
                  "required": [
                    "maximum_ploc_spacing"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "family": {
            "enum": [
              "modality",
              "core",
              "post_calling"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
