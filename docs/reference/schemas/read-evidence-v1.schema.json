{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal:schema:read_evidence:v1",
  "title": "DNA read evidence v1",
  "description": "One read's evidence exactly as the modality hands it to the core (ADR-0069, PROP-0011): per-call verdicts of the kernel contract, with the Sanger signal each rests on, and the Sanger evidence the analysis, sample, consensus, and review documents report beside the core's products; or, for a read the modality sets aside, its rejection with the numbers and evidence the sample documents report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "dna.read_evidence/v1"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_count",
        "trim",
        "informative",
        "ends",
        "reasons",
        "callability",
        "mixtures",
        "unreliable",
        "tracts"
      ],
      "properties": {
        "call_count": {
          "type": "integer",
          "minimum": 0
        },
        "trim": {
          "description": "The relative-quality trim interval, 0-based half-open call indices, as in dna.basecalls/v3.",
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/interval"
        },
        "informative": {
          "description": "The calls the modality retains, 0-based half-open call indices.",
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/interval"
        },
        "ends": {
          "enum": [
            "unvouched",
            "vouched"
          ]
        },
        "reasons": {
          "description": "The modality's reason labels in the order the core reports them.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "callability": {
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/callability"
        },
        "mixtures": {
          "description": "The stretches the modality decomposes into the read's own sequence at whole-call offsets (ADR-0082), in call order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/mixture"
          }
        },
        "unreliable": {
          "description": "The spans of calls whose differences the modality asserts are not to stand unchecked, with its reason (SRS-CALL-024), in call order.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "calls",
              "reason"
            ],
            "properties": {
              "calls": {
                "description": "The span, 0-based half-open call indices.",
                "$ref": "urn:signal:schema:basecalls:v3#/$defs/interval"
              },
              "reason": {
                "enum": [
                  "poor_start_signal"
                ]
              }
            }
          }
        },
        "tracts": {
          "description": "The homopolymer tracts the modality decodes from the read's own signal (PROP-0012), in onset order: evidence only, which the core does not read.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/tract"
          }
        }
      }
    },
    "signal_quality": {
      "description": "Trace integrity and merged noisy regions, as in dna.basecalls/v3.",
      "$ref": "urn:signal:schema:basecalls:v3#/$defs/signalQuality"
    },
    "warnings": {
      "description": "The modality's warning counts, as in dna.basecalls/v3.",
      "$ref": "urn:signal:schema:basecalls:v3#/$defs/warnings"
    },
    "calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/call"
      }
    },
    "rejection": {
      "description": "Why the modality set the read aside, as the sample documents report it.",
      "$ref": "#/$defs/rejection"
    },
    "integrity": {
      "description": "Trace integrity of a read with too few callable calls, as in dna.basecalls/v3.",
      "$ref": "urn:signal:schema:basecalls:v3#/$defs/integrity"
    },
    "callability": {
      "description": "Callability of a read with too few callable calls, as in dna.basecalls/v3.",
      "$ref": "urn:signal:schema:basecalls:v3#/$defs/callability"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "configuration_sha256",
        "plugins",
        "plugin_configuration_sha256"
      ],
      "properties": {
        "input": {
          "description": "The trace the evidence was written from: its file name, from which the sample documents name the read, and its content SHA-256.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/]+$"
            },
            "sha256": {
              "$ref": "urn:signal:schema:basecalls:v3#/$defs/sha256"
            }
          }
        },
        "configuration_sha256": {
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/sha256"
        },
        "plugins": {
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/plugins"
        },
        "plugin_configuration_sha256": {
          "description": "Each plugin's configuration digest, by plugin id: the SHA-256 of one '<section>\\t<section digest>' line per configuration section the plugin owns, each section digest the SHA-256 of the section's values in canonical form. The reader compares these, not the configuration file's SHA-256.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "urn:signal:schema:basecalls:v3#/$defs/sha256"
          }
        }
      }
    },
    "rejection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "calls",
            "minimum_calls"
          ],
          "properties": {
            "reason": {
              "const": "too_short"
            },
            "calls": {
              "type": "integer",
              "minimum": 1
            },
            "minimum_calls": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "callable_calls",
            "minimum_callable_calls"
          ],
          "properties": {
            "reason": {
              "const": "callable_calls_below_minimum"
            },
            "callable_calls": {
              "type": "integer",
              "minimum": 0
            },
            "minimum_callable_calls": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "withheld"
      ],
      "properties": {
        "edge": {
          "type": "boolean"
        },
        "withheld": {
          "description": "The modality's reasons against this use, verbatim, in the order raised; every one is listed in read.reasons.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "base",
        "placement",
        "identity",
        "indel",
        "bound",
        "post_repeat",
        "second_unexplained",
        "reference_only",
        "signal"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "base": {
          "type": "string",
          "enum": [
            "A",
            "C",
            "G",
            "T",
            "N"
          ]
        },
        "profile": {
          "description": "Basecall-independent A/C/G/T weights summing to one, when the call has signal, at full precision: the core's alignment scores read them finer than three decimals.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "scored",
                "anchoring",
                "unresolved"
              ]
            },
            "reason": {
              "$ref": "#/$defs/reason"
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "scored"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reason"
              ]
            }
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        },
        "identity": {
          "$ref": "#/$defs/verdict"
        },
        "indel": {
          "$ref": "#/$defs/verdict"
        },
        "bound": {
          "enum": [
            "in_phase",
            "anchored",
            "withheld"
          ]
        },
        "post_repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "call",
            "bound"
          ],
          "properties": {
            "call": {
              "type": "boolean"
            },
            "bound": {
              "type": "boolean"
            }
          }
        },
        "second": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "share",
            "stands_out"
          ],
          "properties": {
            "base": {
              "enum": [
                "A",
                "C",
                "G",
                "T"
              ]
            },
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "description": "The second channel's share of the call's two strongest peaks, at full precision: the review judges it against its threshold."
            },
            "stands_out": {
              "type": "boolean"
            }
          }
        },
        "second_unexplained": {
          "type": "boolean"
        },
        "reference_only": {
          "type": "boolean"
        },
        "signal": {
          "description": "The Sanger signal the verdicts rest on: the trace sample of the call's locus, the selected A/C/G/T peak of each channel in its window, the A/C/G/T heights at its primary event, its relative quality, and the cause of its second peak (SRS-CALL-021).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scan",
            "channels",
            "relative_quality"
          ],
          "properties": {
            "scan": {
              "type": "integer",
              "minimum": 0
            },
            "channels": {
              "description": "The selected A/C/G/T peak heights in the call's window, on the read strand: what the run signal counts and second shares are measured from.",
              "$ref": "#/$defs/peaks"
            },
            "peaks": {
              "description": "A/C/G/T channel heights at the call's primary event, on the read strand, when the call has one.",
              "$ref": "#/$defs/peaks"
            },
            "relative_quality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "cause": {
              "enum": [
                "noise",
                "neighbour_tail",
                "off_centre",
                "dye_blob",
                "phase_shift",
                "second_template",
                "mixed_stretch"
              ],
              "description": "Present exactly when the call has a second peak (SRS-CALL-021): a share above signal_processing.second_floor, whose second base then stands out, or a call masked as mixed whose own second peak is small (mixed_stretch), whose second base does not."
            }
          }
        }
      }
    },
    "mixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "run_calls",
        "explained",
        "residual",
        "components",
        "unexplained"
      ],
      "properties": {
        "calls": {
          "description": "The stretch, 0-based half-open call indices, from the run whose length varies.",
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/interval"
        },
        "run_calls": {
          "description": "Calls of that run, from calls.start.",
          "type": "integer",
          "minimum": 1
        },
        "explained": {
          "description": "The residual is at most the read's own in-phase residual at the modality's unexplained quantile.",
          "type": "boolean"
        },
        "residual": {
          "description": "Root mean square per call of what the components leave, on the modality's normalised scale. At full precision.",
          "type": "number",
          "minimum": 0
        },
        "components": {
          "description": "Offset 0 (the dominant sequence) first, the rest by decreasing fraction.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "fraction"
            ],
            "properties": {
              "offset": {
                "type": "integer"
              },
              "fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "The component's fraction, at full precision."
              }
            }
          }
        },
        "unexplained": {
          "description": "Calls of the stretch whose signal the components do not explain, increasing.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onset",
        "calls",
        "extent",
        "run",
        "mark",
        "candidates",
        "residual",
        "sigma",
        "autocorrelation",
        "first",
        "total",
        "cleaned"
      ],
      "properties": {
        "onset": {
          "description": "The call where the read leaves phase (the start of a callability segment not in phase), after the tract.",
          "type": "integer",
          "minimum": 1
        },
        "calls": {
          "description": "The calls the decode fits, 0-based half-open, from the tract's first call.",
          "$ref": "urn:signal:schema:basecalls:v3#/$defs/interval"
        },
        "extent": {
          "description": "Calls from the tract's first one that read the run or the chosen mark; at most the calls fitted.",
          "type": "integer",
          "minimum": 1
        },
        "run": {
          "enum": [
            "A",
            "C",
            "G",
            "T"
          ],
          "description": "The run base on the read strand."
        },
        "mark": {
          "description": "The chosen structure's mark between the tract's two runs, on the read strand; null for a single run.",
          "enum": [
            "A",
            "C",
            "G",
            "T",
            null
          ]
        },
        "candidates": {
          "description": "Every structure fitted over the same calls: the single run first, then each other base in A, C, G, T order. The chosen one has the lowest residual, the earlier one on a tie.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mark",
              "residual"
            ],
            "properties": {
              "mark": {
                "enum": [
                  "A",
                  "C",
                  "G",
                  "T",
                  null
                ]
              },
              "residual": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "residual": {
          "type": "number",
          "minimum": 0,
          "description": "The chosen decode's root mean square residual per channel row, as its candidate's."
        },
        "sigma": {
          "type": "number",
          "minimum": 0,
          "description": "The residual scaled to the fit's degrees of freedom."
        },
        "autocorrelation": {
          "description": "Lag-1 autocorrelation of the residual along the calls: the lagged products over the squares of all calls but the last, so it can exceed one slightly.",
          "type": "number"
        },
        "first": {
          "description": "The first run's length marginal.",
          "$ref": "#/$defs/length_marginal"
        },
        "total": {
          "description": "The total length marginal: run, mark, and run.",
          "$ref": "#/$defs/length_marginal"
        },
        "cleaned": {
          "description": "The chosen structure refitted with the read's own base signatures and leakage over the signature decode's downstream sequence; null when the refit does not fit.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "leakage",
                "residual",
                "first"
              ],
              "properties": {
                "leakage": {
                  "description": "Each neighbour offset's share of a call's signal, from the read's calls before the tract; null when too few calls measure it.",
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "offset",
                          "share"
                        ],
                        "properties": {
                          "offset": {
                            "type": "integer",
                            "not": {
                              "const": 0
                            }
                          },
                          "share": {
                            "type": "number",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  ]
                },
                "residual": {
                  "type": "number",
                  "minimum": 0,
                  "description": "The refit's residual."
                },
                "first": {
                  "description": "The refit's first-run marginal.",
                  "$ref": "#/$defs/length_marginal"
                }
              }
            }
          ]
        }
      }
    },
    "length_marginal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lengths",
        "shares",
        "errors",
        "dominant",
        "next",
        "z",
        "z_adjusted",
        "margin"
      ],
      "properties": {
        "lengths": {
          "description": "The lengths, strictly ascending.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "shares": {
          "description": "Each length's share of the fitted signal, summing to one: signal shares, never heteroplasmy levels.",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "errors": {
          "description": "Each share's standard error from the fit.",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "dominant": {
          "description": "The length with the largest share.",
          "type": "integer",
          "minimum": 1
        },
        "next": {
          "description": "The length with the next largest positive share; null when a single length shows.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "z": {
          "description": "The dominant share's margin over the next, in standard errors of their difference; null when a single length shows or the margin is not finite.",
          "type": [
            "number",
            "null"
          ]
        },
        "z_adjusted": {
          "description": "z deflated by the read's residual autocorrelation.",
          "type": [
            "number",
            "null"
          ]
        },
        "margin": {
          "description": "How the dominant length stands against the next: clear when a single length shows or z_adjusted reaches the configured level (trace.near_equal_z), near_equal below it, and undefined, never clear, when two lengths show without a finite z_adjusted.",
          "enum": [
            "clear",
            "near_equal",
            "undefined"
          ]
        }
      }
    },
    "peaks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "C",
        "G",
        "T"
      ],
      "properties": {
        "A": {
          "type": "integer"
        },
        "C": {
          "type": "integer"
        },
        "G": {
          "type": "integer"
        },
        "T": {
          "type": "integer"
        }
      }
    }
  },
  "oneOf": [
    {
      "description": "A read the modality hands to the core.",
      "required": [
        "read",
        "signal_quality",
        "warnings",
        "calls"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "rejection"
            ]
          },
          {
            "required": [
              "integrity"
            ]
          },
          {
            "required": [
              "callability"
            ]
          }
        ]
      }
    },
    {
      "description": "A read the modality set aside: with its integrity and callability unless it was too short to process.",
      "required": [
        "rejection"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "read"
            ]
          },
          {
            "required": [
              "signal_quality"
            ]
          },
          {
            "required": [
              "warnings"
            ]
          },
          {
            "required": [
              "calls"
            ]
          }
        ]
      },
      "if": {
        "properties": {
          "rejection": {
            "properties": {
              "reason": {
                "const": "too_short"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "integrity"
              ]
            },
            {
              "required": [
                "callability"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "integrity",
          "callability"
        ]
      }
    }
  ]
}
