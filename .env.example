# Optional shell/IDE convenience template.
#
# DNA does NOT load .env files. Copy this file to .env only when your shell,
# IDE, container, or other local tooling exports dotenv values into the process
# environment before invoking the Rust binary.
#
# Scientific parameters do not belong here. They live in the strict,
# versioned TOML selected by DNA_CONFIG.

# Path to the strict DNA TOML configuration.
# Default when unset: config/dna.toml
# Relative paths are resolved from the process working directory.
DNA_CONFIG=config/dna.toml

# Directory for append-only operational logs.
# Default when unset: logs
# This affects only log placement; it does not change scientific configuration
# or the configuration checksum.
DNA_LOG_DIR=logs
